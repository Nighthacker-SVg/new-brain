{
  "name": "attendx-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "playwright test",
    "test:server": "node --test server/test/*.test.mjs runner/test/*.test.mjs",
    "test:runner": "node --test runner/test/docker.integration.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:local": "node scripts/test-live.mjs --local-only",
    "server": "node server/api.mjs",
    "web-preview": "npm run build && vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.9.0"
}
